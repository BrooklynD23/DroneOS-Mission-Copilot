{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "mission_id": {
      "type": "string",
      "maxLength": 64
    },
    "speed_mps": {
      "type": "number",
      "minimum": 1,
      "maximum": 15
    },
    "waypoints": {
      "minItems": 1,
      "maxItems": 50,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^wp\\d{1,3}$"
          },
          "lat": {
            "type": "number",
            "minimum": -90,
            "maximum": 90
          },
          "lon": {
            "type": "number",
            "minimum": -180,
            "maximum": 180
          },
          "alt_m": {
            "type": "number"
          },
          "action": {
            "type": "string",
            "enum": [
              "photo",
              "hover",
              "none"
            ]
          },
          "hold_s": {
            "type": "number",
            "minimum": 0,
            "maximum": 60
          }
        },
        "required": [
          "id",
          "lat",
          "lon",
          "alt_m",
          "action",
          "hold_s"
        ],
        "additionalProperties": false
      }
    },
    "notes": {
      "maxItems": 10,
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 200
      }
    }
  },
  "required": [
    "mission_id",
    "speed_mps",
    "waypoints",
    "notes"
  ],
  "additionalProperties": false
}
