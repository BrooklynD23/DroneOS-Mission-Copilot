{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "t_s": {
      "type": "number",
      "minimum": 0
    },
    "ts": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "lat": {
      "type": "number",
      "minimum": -90,
      "maximum": 90
    },
    "lon": {
      "type": "number",
      "minimum": -180,
      "maximum": 180
    },
    "alt_m": {
      "type": "number"
    },
    "battery_pct": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "mode": {
      "type": "string",
      "maxLength": 32
    },
    "frame_id": {
      "type": "string",
      "pattern": "^\\d{6}$"
    }
  },
  "required": [
    "t_s",
    "ts",
    "lat",
    "lon",
    "alt_m",
    "battery_pct",
    "mode"
  ],
  "additionalProperties": false
}
